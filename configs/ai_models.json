{
  "pipeline_version": "2.0.0",
  "provider": "hf-inference",
  "cost_policy": {
    "max_cloud_requests_per_map": 20,
    "request_timeout_seconds": 45,
    "retry_limit": 2,
    "cache_enabled": true,
    "cache_dir": "cache/ai_inference"
  },
  "quality_threshold": {
    "min_improvement_delta": 0.05,
    "min_ssim_retention": 0.70,
    "min_psnr_db": 22.0,
    "min_aesthetic_score": 6.5
  },
  "analysis_models": {
    "primary": "Qwen/Qwen2.5-VL-72B-Instruct",
    "fast": "Qwen/Qwen2.5-VL-7B-Instruct",
    "fallback": "meta-llama/Llama-3.2-11B-Vision-Instruct"
  },
  "image_models": {
    "texture_generation": "black-forest-labs/FLUX.1-schnell",
    "texture_enhancement": "stabilityai/stable-diffusion-xl-refiner-1.0",
    "fallback": "runwayml/stable-diffusion-v1-5"
  },
  "upscalers": {
    "super_resolution": "caidas/swin2SR-classical-sr-x2-64",
    "denoise_upscale": "RealESRGAN_x4plus",
    "fallback": "bicubic_lanczos"
  },
  "material_interpretation_candidates": [
    "asphalt_weathered",
    "concrete_poured",
    "brick_red_masonry",
    "plaster_stucco",
    "wood_plank_aged",
    "metal_corrugated",
    "roof_tile_slate",
    "glass_architectural",
    "grass_natural_meadow",
    "soil_compacted"
  ]
}
